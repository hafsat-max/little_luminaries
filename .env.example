# Teacher login. Set strong production values and do not commit .env.local.
TEACHER_EMAIL=teacher@littleluminaries.com
TEACHER_PASSWORD=change-this-password
SESSION_SECRET=replace-with-a-long-random-secret

# Optional real email delivery through Resend. Without these, assignments are
# persisted locally with deliveryMode "development" and no email is transmitted.
RESEND_API_KEY=
EMAIL_FROM=Little Luminaries <assignments@your-verified-domain.com>
